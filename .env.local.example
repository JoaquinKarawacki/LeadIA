# Copiar este archivo a .env.local (nunca commitear .env.local, ver .gitignore)
# y completar los valores reales ahí.

# ── Supabase ────────────────────────────────────────────────
# Project URL y anon key: dashboard de Supabase → Settings → API.
# Llevan el prefijo NEXT_PUBLIC_ porque Next.js las expone al browser
# a propósito; la seguridad de los datos la da RLS, no el secreto de estas keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: dashboard de Supabase → Settings → API → service_role.
# SECRETA. Bypassa Row-Level Security por completo.
# Usar solo en código server-side (workers, jobs, tareas de admin) y
# NUNCA importarla en un archivo que corra en el browser.
SUPABASE_SERVICE_ROLE_KEY=

# Access token personal para el CLI de Supabase (dashboard → Account → Access Tokens).
# Solo se usa en desarrollo local para correr migraciones, nunca en runtime de la app.
SUPABASE_ACCESS_TOKEN=

# ── IA / src/utilidades/llm.ts — Etapa 2 ───────────────────────
# Todas las llamadas a IA pasan por Vercel AI Gateway (modelos "proveedor/modelo"
# vía el paquete `ai`, sin SDK de proveedor específico). En producción (deploy en
# Vercel) el Gateway se autentica solo vía OIDC, sin ninguna key. Esta key es
# solo para desarrollo local: dashboard de Vercel → proyecto → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# ── Búsqueda web para investigación de empresas — Etapa 2 ──────
# Exa Search API, provisionada vía Vercel Marketplace (`vercel integration add
# exa/exa-search-api`) — auto-generada, no se saca del dashboard de Exa a mano.
EXA_API_KEY=

# ── Envío de emails — Etapa 6 (futuro) ─────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=

# Copiar este archivo a .env.local (nunca commitear .env.local, ver .gitignore)
# y completar los valores reales ahí.

# ── Supabase ────────────────────────────────────────────────
# Project URL y anon key: dashboard de Supabase → Settings → API.
# Llevan el prefijo NEXT_PUBLIC_ porque Next.js las expone al browser
# a propósito; la seguridad de los datos la da RLS, no el secreto de estas keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: dashboard de Supabase → Settings → API → service_role.
# SECRETA. Bypassa Row-Level Security por completo.
# Usar solo en código server-side (workers, jobs, tareas de admin) y
# NUNCA importarla en un archivo que corra en el browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── IA / lib/llm.ts — Etapa 2 (todavía sin usar) ───────────────
# Proveedor de inferencia por token (Together, Groq, Fireworks, DeepInfra
# u otro). Definir según el proveedor elegido; la key nunca se hardcodea,
# siempre se lee desde acá dentro de lib/llm.ts.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=

# ── Búsqueda web para investigación de empresas — Etapa 2 (futuro) ──
WEB_SEARCH_API_KEY=

# ── Envío de emails — Etapa 6 (futuro) ─────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=
